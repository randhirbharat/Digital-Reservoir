# Copy to .env and fill in. NEVER commit real secrets. (Docker: use .env.docker.example instead.)
# Admin password for `python -m app.cli create-admin` is prompted (or DR_ADMIN_PASSWORD in automation) — never stored here.
# ---------- Shared ----------
DR_ENV=development                       # development | production
DR_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Runtime role MUST be a non-superuser without BYPASSRLS (row-level security); migrations use the owner role.
DR_DATABASE_URL=postgresql+psycopg://dr_app:replace-me@localhost:5432/digital_reservoir
DR_REDIS_URL=redis://localhost:6379/0     # optional; rate limiting falls back to in-memory
DR_STORAGE_DIR=./storage                  # local object storage root (S3-compatible adapter: see docs)
DR_COOKIE_DOMAIN=                         # e.g. .digitalreservoir.in in production; empty for localhost
DR_COOKIE_SECURE=false                    # true in production (HTTPS only)
DR_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DR_SESSION_HOURS=12                       # absolute session lifetime
DR_SESSION_IDLE_MINUTES=120               # idle timeout
DR_LOGIN_RATE_PER_MINUTE=10
DR_MAX_FAILED_LOGINS=8
DR_LOCKOUT_MINUTES=15
DR_REQUIRE_MFA_FOR_ADMINS=false           # set true in production
DR_TWIN_ENFORCE_MFA=true                  # projects with require_mfa demand an MFA-verified session
# Links in emails
DR_LAB_URL=http://localhost:3001
DR_TWIN_URL=http://localhost:3002
# Email: "console" writes verification/reset mails to the API log and the email_outbox table.
DR_EMAIL_BACKEND=console                  # console | smtp
DR_SMTP_HOST=
DR_SMTP_PORT=587
DR_SMTP_USER=
DR_SMTP_PASSWORD=
DR_SMTP_FROM=no-reply@example.org
# Demonstration telemetry
DR_SIMULATOR_ENABLED=true
DR_SIMULATOR_INTERVAL_SECONDS=5
# Ingestion API
DR_INGEST_RATE_PER_MINUTE=600             # per gateway key
# ---------- Frontends (public, browser-visible — no secrets here) ----------
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_LAB_URL=http://localhost:3001
NEXT_PUBLIC_TWIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only: where Next.js rewrites /api/* to
DR_API_INTERNAL_URL=http://localhost:8000
# ---------- Data ingestion service ----------
DR_INGEST_API_URL=http://localhost:8000
DR_INGEST_GATEWAY_KEY=                    # issued per gateway by a project administrator
DR_MQTT_HOST=localhost
DR_MQTT_PORT=1883
