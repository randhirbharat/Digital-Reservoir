# Copy to .env.docker and replace every value. Never commit the real file.
POSTGRES_USER=dr_owner
POSTGRES_PASSWORD=replace-with-strong-owner-password
POSTGRES_DB=digital_reservoir
DR_APP_DB_PASSWORD=replace-with-strong-app-password
DR_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
DR_ENV=development
DR_COOKIE_SECURE=false
DR_SIMULATOR_ENABLED=true
DR_TWIN_ENFORCE_MFA=true
DR_EMAIL_BACKEND=console
# Production (behind HTTPS): DR_ENV=production, DR_COOKIE_SECURE=true, DR_COOKIE_DOMAIN=.your-domain, and the public URLs below.
# NEXT_PUBLIC_* values are compiled into the web images at build time: rebuild after changing them.
#NEXT_PUBLIC_PUBLIC_URL=https://www.example.org
#NEXT_PUBLIC_LAB_URL=https://lab.example.org
#NEXT_PUBLIC_TWIN_URL=https://secure.example.org
#NEXT_PUBLIC_API_URL=https://api.example.org
#DR_COOKIE_DOMAIN=.example.org
# Optional image mirror (e.g. when Docker Hub rate-limits):
#DR_IMAGE_REGISTRY=mirror.gcr.io/library
#DR_IMAGE_HUB=mirror.gcr.io
# Optional MQTT bridge (profile "mqtt"): gateway key issued in the Twin (Sensors → Gateways, project administrators)
#DR_INGEST_GATEWAY_KEY=
#DR_BRIDGE_PROJECT=PRJ-A
